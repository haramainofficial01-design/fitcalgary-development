# Copy this file outside the repository and replace every .invalid placeholder.
# The release scripts reject localhost, .invalid and insecure production URLs.
PRODUCTION_BUILD=true
API_BASE_URL=https://api.fitcalgary.invalid/api/v1
OIDC_ISSUER=https://auth.fitcalgary.invalid/realms/fitcalgary
OIDC_CLIENT_ID=fitcalgary-mobile
ALLOW_INSECURE_OIDC=false
FITCALGARY_ASSOCIATED_DOMAIN=fitcalgary.invalid

# Leave all Firebase values blank when push delivery is not being included in
# this build. If any core Firebase value is supplied, all four are required.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
